# Copy to .env for local development. On Railway, set these as service variables
# (Railway's "Raw Editor" accepts this format; keep comments on their own lines).

# ---------------- Required in production ----------------
# "production" on Railway, "development" locally
ENVIRONMENT=development
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leads
# Random 48+ characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# true in production (cookies only over HTTPS)
SESSION_HTTPS_ONLY=false

# ---------------- First run ----------------
# Creates the first admin account if no users exist yet.
# Remove both after your first login, then change the password inside the app.
INITIAL_ADMIN_EMAIL=admin@idealz.lk
INITIAL_ADMIN_PASSWORD=change-this-password
INITIAL_ADMIN_NAME=Administrator
# Creates WhatsApp Hotline 1-5, Facebook, Instagram, TikTok, Phone call, Walk-in, Website
SEED_DEFAULT_CHANNELS=true

# ---------------- Branding & locale ----------------
APP_NAME=iDealz Lead Tracker
COMPANY_NAME=iDealz Lanka
TIMEZONE=Asia/Colombo
DEFAULT_PHONE_REGION=LK

# ---------------- Follow-up rules ----------------
FOLLOWUP_MAX_ATTEMPTS=4
BUSINESS_DAY_START_HOUR=10
BUSINESS_DAY_END_HOUR=20
# Placeholders: {name} {agent} {company} {product}
WHATSAPP_FOLLOWUP_TEMPLATE=Hi {name}, this is {agent} from {company}. Following up on the {product} you asked about. Can I help you with the price, stock or installment options?

# ---------------- Integrations (optional) ----------------
# Set to enable POST /api/v1/inquiries (website forms, chatbots, Meta webhooks)
API_KEY=

# ---------------- Server ----------------
WEB_CONCURRENCY=1
SESSION_MAX_AGE_HOURS=12
